#!/usr/bin/env bash
# wdn — the wardner command line entry point
#
#   wdn update     update every downloaded repo to the latest GitHub
#                  revision and re-sync the venv
#   wdn status     show the local commit / remote of every repo and the
#                  state of the venv
#   wdn doctor     check the system environment: the native .so files, the
#                  system libraries of the hardware engines (MPP / RGA /
#                  Mali / RKNN), the SDK versions, the dependency
#                  versions, the plugin registration
#   wdn version    print the version
#
# Two layers:
#   * this file (bash) only finds itself + finds the python of the venv,
#     then execs;
#   * the real CLI is ../cli/wdn.py, run with the **venv python** — that
#     way it can naturally import the SDKs for a health check and confirm
#     that the environment before and after the update is the same
#     interpreter.
#
# ⚠️ This file is symlinked into ~/.local/bin, so the symlink chain has to
#    be resolved to get the real location — otherwise the relative paths of
#    lib/ and cli/ are all wrong.

set -euo pipefail

# --- resolve the symlink chain to get the real path ---
_self="$0"
while [ -L "$_self" ]; do
    _dir="$(cd -P "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
        /*) ;;
        *) _self="$_dir/$_self" ;;
    esac
done
BIN_DIR="$(cd -P "$(dirname "$_self")" && pwd)"
ROOT="$(cd -P "$BIN_DIR/.." && pwd)"

# --- locate the install root ---
#
# When WARDNER_HOME is not set it is derived from the location of this
# script: <home>/wardner/bin/wdn → <home>. Note that this is "the parent
# directory of this repo", not ~/.wardner — so it also works when
# everything is installed somewhere else.
if [ -z "${WARDNER_HOME:-}" ]; then
    WARDNER_HOME="$(cd -P "$ROOT/.." && pwd)"
fi
export WARDNER_HOME

CLI="$ROOT/cli/wdn.py"
VENV_PY="$WARDNER_HOME/wdnwebui/.venv/bin/python"

if [ ! -f "$CLI" ]; then
    printf '[fail] the CLI was not found: %s\n' "$CLI" >&2
    exit 1
fi

if [ ! -x "$VENV_PY" ]; then
    printf '[fail] not installed yet — the python of the venv was not found\n' >&2
    printf '       %s\n' "$VENV_PY" >&2
    printf '       run the installer once first: bash %s/install.sh\n' "$ROOT" >&2
    exit 1
fi

exec "$VENV_PY" "$CLI" "$@"
